{
  "name": "kitchen-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Домашний склад продуктов — личное PWA (ADR-001)",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "test": "vitest run && npm run --silent typecheck",
    "typecheck": "tsc -p tsconfig.domain.json && tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "start": "node src/server/main.ts",
    "dev:server": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "build:web": "vite build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
